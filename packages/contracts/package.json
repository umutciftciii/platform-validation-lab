{
  "name": "@dream/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API contracts (Zod): health, error envelope, common auth types.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput --watchFile dynamicPriorityPolling --watchDirectory dynamicPriorityPolling",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dream/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
