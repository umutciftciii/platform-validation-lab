# Copy to .env (git-ignored) and fill in local values. Never commit real values.
# Docker Compose reads this file through `--env-file .env`.

# PostgreSQL, local only. Each mode has its own data volume, database, user and password
# (docs/adr/ADR-009-local-postgres-separation.md). Choose your own passwords; they are not
# shared secrets. The dev and prod database names and users must differ (stack.sh checks it).

# Local production-build mode (`stack.sh prod up`), volume dream-petroleum-platform_postgres-data
POSTGRES_DB=dream_platform
POSTGRES_USER=dream_platform
POSTGRES_PASSWORD=change-me-local-only

# Dev mode (`stack.sh dev up`), volume dream-petroleum-platform_postgres-data-dev
DEV_POSTGRES_DB=dream_platform_dev
DEV_POSTGRES_USER=dream_platform_dev
DEV_POSTGRES_PASSWORD=change-me-dev-local-only

# Separated database roles (ADR-012A), one password each, per mode. At least 16 characters and
# all different within a mode (the role setup refuses anything else); dev and prod must differ
# too, and only URL-safe characters (A-Z a-z 0-9 . _ ~ -) are allowed (stack.sh checks both). The superuser above (POSTGRES_USER) is for infrastructure only:
#   dp_app            the API (data access only)
#   dp_migrator       the migration runner and iam:sync (acts as dp_owner, which owns the schema)
#   dp_iam_bootstrap  the one-time bootstrap of the first administrator; never given to the API
# Never put real passwords here; .env is git-ignored. New data volumes get the roles from the
# init script; an existing volume needs `infra/docker/stack.sh db-roles <mode>` once.
DP_APP_PASSWORD=change-me-app-local-only
DP_MIGRATOR_PASSWORD=change-me-migrator-local-only
DP_IAM_BOOTSTRAP_PASSWORD=change-me-bootstrap-local-only
DEV_DP_APP_PASSWORD=change-me-dev-app-local-only
DEV_DP_MIGRATOR_PASSWORD=change-me-dev-migrator-local-only
DEV_DP_IAM_BOOTSTRAP_PASSWORD=change-me-dev-bootstrap-local-only

# Staff authentication (F1-002 Group 2, ADR-013 D2/D19). Per mode, all values different; the API
# refuses to start if one is missing, shorter than 43 base64url characters (32 bytes) or shared.
# Generate each value with:  openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#   DP_PROXY_KEY_<APP>   per-app proxy key: the API gets all three, each Next app only its own.
#                        Optional rotation slot <NAME>_NEXT (docs/security/proxy-key-rotation.md).
#   IAM_MFA_ENC_KEYS     TOTP encryption keyring, "<version>:<32-byte base64url key>[,…]"
#   IAM_HMAC_KEY         HMAC key for recovery codes and login throttle buckets
# The values below are placeholders for a throwaway local stack only (CI copies this file).
DP_PROXY_KEY_ADMIN=change-me-prod-admin-proxy-key-local-000000
DP_PROXY_KEY_WEB_BV=change-me-prod-web-bv-proxy-key-local-00000
DP_PROXY_KEY_WEB_CORPORATE=change-me-prod-corporate-proxy-key-00000000
IAM_MFA_ENC_KEYS=1:change-me-prod-mfa-encryption-key-000000000
IAM_HMAC_KEY=change-me-prod-iam-hmac-key-local-only-0000
DEV_DP_PROXY_KEY_ADMIN=change-me-dev-admin-proxy-key-local-0000000
DEV_DP_PROXY_KEY_WEB_BV=change-me-dev-web-bv-proxy-key-local-000000
DEV_DP_PROXY_KEY_WEB_CORPORATE=change-me-dev-corporate-proxy-key-000000000
DEV_IAM_MFA_ENC_KEYS=1:change-me-dev-mfa-encryption-key-0000000000
DEV_IAM_HMAC_KEY=change-me-dev-iam-hmac-key-local-only-00000

# Prisma CLI on the host (published port 5440 serves the database of the running mode).
# Inside Compose each service gets its own URL per mode with host "postgres" and port 5432:
# the API DATABASE_URL (dp_app), the runner MIGRATE_DATABASE_URL (dp_migrator).
DATABASE_URL=postgresql://dp_app:change-me-app-local-only@127.0.0.1:5440/dream_platform?schema=public
MIGRATE_DATABASE_URL=postgresql://dp_migrator:change-me-migrator-local-only@127.0.0.1:5440/dream_platform?schema=public
DEV_DATABASE_URL=postgresql://dp_app:change-me-dev-app-local-only@127.0.0.1:5440/dream_platform_dev?schema=public

# Public base URLs (local)
WEB_BV_URL=http://localhost:3110
WEB_CORPORATE_URL=http://localhost:3111
ADMIN_URL=http://localhost:3112
API_URL=http://localhost:3113

# DP-119 (optional, DEV): base of the invitation/recovery links. After trusting the DEV HTTPS root
# (`infra/docker/stack.sh dev tls-ca`), links can use the HTTPS proxy, which Safari needs.
# DEV_DP_ADMIN_BASE_URL=https://admin.localhost:3114
